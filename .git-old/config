[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/AnuradhaPathirana/ERP.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "master"]
	remote = origin
	merge = refs/heads/master
[branch "agents/claude-access-issue-resolution"]
	vscode-merge-base = origin/master
[branch "qa"]
	vscode-merge-base = origin/master
	remote = origin
	merge = refs/heads/qa
[branch "MobileApp"]
	vscode-merge-base = origin/master
	remote = origin
	merge = refs/heads/MobileApp
